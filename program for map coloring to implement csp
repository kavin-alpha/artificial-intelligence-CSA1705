# Map Coloring using CSP

colors = ['Red', 'Green', 'Blue']

map = {
    'A': ['B', 'C'],
    'B': ['A', 'C', 'D'],
    'C': ['A', 'B', 'D'],
    'D': ['B', 'C']
}

assignment = {}

def is_safe(region, color):
    for neighbour in map[region]:
        if neighbour in assignment and assignment[neighbour] == color:
            return False
    return True

def solve():
    if len(assignment) == len(map):
        return True

    region = [r for r in map if r not in assignment][0]

    for color in colors:
        if is_safe(region, color):
            assignment[region] = color

            if solve():
                return True

            del assignment[region]

    return False

if solve():
    print("Map Coloring Solution:")
    for region, color in assignment.items():
        print(region, ":", color)
else:
    print("No solution exists")
