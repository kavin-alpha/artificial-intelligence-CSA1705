# Minimax Algorithm for Tic-Tac-Toe

def minimax(board, depth, is_max):
    if "X" in board and board.count("X") >= 3:
        if check_winner(board, "X"):
            return 10 - depth

    if check_winner(board, "O"):
        return depth - 10

    if " " not in board:
        return 0

    if is_max:
        best = -1000

        for i in range(9):
            if board[i] == " ":
                board[i] = "X"
                best = max(best, minimax(board, depth + 1, False))
                board[i] = " "

        return best

    else:
        best = 1000

        for i in range(9):
            if board[i] == " ":
                board[i] = "O"
                best = min(best, minimax(board, depth + 1, True))
                board[i] = " "

        return best


def check_winner(board, player):
    wins = [
        (0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)
    ]

    return any(board[a] == board[b] == board[c] == player
               for a, b, c in wins)


def best_move(board):
    best_value = -1000
    move = -1

    for i in range(9):
        if board[i] == " ":
            board[i] = "X"
            value = minimax(board, 0, False)
            board[i] = " "

            if value > best_value:
                best_value = value
                move = i

    return move


board = [" ", " ", " ",
         " ", " ", " ",
         " ", " ", " "]

print("Best move for AI:", best_move(board) + 1)
