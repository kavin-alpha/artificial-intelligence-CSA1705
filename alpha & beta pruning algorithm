# Alpha-Beta Pruning Algorithm

def alphabeta(depth, node, maximizing, values, alpha, beta):
    # Leaf node
    if depth == 3:
        return values[node]

    if maximizing:
        best = -9999

        for i in range(2):
            value = alphabeta(depth + 1, node * 2 + i,
                              False, values, alpha, beta)
            best = max(best, value)
            alpha = max(alpha, best)

            # Beta cut-off
            if beta <= alpha:
                break

        return best

    else:
        best = 9999

        for i in range(2):
            value = alphabeta(depth + 1, node * 2 + i,
                              True, values, alpha, beta)
            best = min(best, value)
            beta = min(beta, best)

            # Alpha cut-off
            if beta <= alpha:
                break

        return best


# Leaf node values
values = [3, 5, 6, 9, 1, 2, 0, -1]

alpha = -9999
beta = 9999

result = alphabeta(0, 0, True, values, alpha, beta)

print("Optimal value:", result)
