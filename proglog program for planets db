% Queries

% Find the type of a planet
planet_type(Name, Type) :-
    planet(Name, Type, _).

% Find the diameter of a planet
planet_diameter(Name, Diameter) :-
    planet(Name, _, Diameter).

% Find all rocky planets
rocky_planet(Name) :-
    planet(Name, rocky, _).

% Find all gas giant planets
gas_giant(Name) :-
    planet(Name, gas_giant, _).
